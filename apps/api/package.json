    "eval": "tsx src/evals/cli.ts"
  },
  "dependencies": {
    "@co/shared": "*",
    "@google/genai": "^1.0.0",
    "express": "^4.21.2",
    "firebase-admin": "^13.0.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.7",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
