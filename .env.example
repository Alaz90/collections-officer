# Copy to .env for local runs. On Render, set these as environment variables.
# Nothing here is required for a local demo: missing keys fall back to local stand-ins.

PORT=8080
PUBLIC_BASE_URL=http://localhost:8080      # https://<your-service>.onrender.com in production
DASHBOARD_ORIGIN=http://localhost:5173
CRON_SECRET=                               # long random string; GitHub Actions sends it to start the daily cycle

STORE=memory                               # firestore in production
FIREBASE_PROJECT_ID=collections-officer
FIREBASE_SERVICE_ACCOUNT=                  # the service account JSON, pasted as one line

AUTH_MODE=demo                             # firebase in production
MANAGER_EMAILS=manager@demo-lender.com
OFFICER_EMAILS=officer@demo-lender.com

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

CHAPA_SECRET_KEY=                          # CHASECK_TEST-...
CHAPA_WEBHOOK_SECRET=

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=demolender_collections_bot
TELEGRAM_WEBHOOK_SECRET=                   # long random string (letters, digits, _ and -)

WEATHER=open-meteo
SEED_DEMO=true
LENDER_ID=demo
